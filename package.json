{
  "name": "peeplx-monorepo",
  "version": "1.0.0",
  "description": "PeeplX - Secure Escrow Infrastructure Platform for Safe Transactions",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "clean": "rm -rf backend/dist frontend/dist node_modules backend/node_modules frontend/node_modules",
    "install-all": "npm install && npm install -w backend && npm install -w frontend"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "escrow",
    "fintech",
    "transactions",
    "trust-score",
    "payment-infrastructure",
    "africa"
  ],
  "author": "PeeplX Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/peeplx/peeplx-platform.git"
  }
}
