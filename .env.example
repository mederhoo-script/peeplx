# Database
DATABASE_URL="postgresql://user:password@localhost:5432/peeplx"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Monnify API
MONNIFY_API_KEY="your-monnify-api-key"
MONNIFY_SECRET_KEY="your-monnify-secret-key"
MONNIFY_CONTRACT_CODE="your-monnify-contract-code"
MONNIFY_BASE_URL="https://api.monnify.com"
MONNIFY_WEBHOOK_SECRET="your-webhook-secret"

# Email (Optional - for future use)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="noreply@peeplx.com"
