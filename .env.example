# =============================================================================
# PEEPLX — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
#
# VERCEL DEPLOYMENT: Set each variable below via the Vercel project dashboard
# (Settings → Environment Variables) or with `vercel env add`.
# Do NOT use the `env` block with @secret_name references in vercel.json —
# that is the legacy Vercel Secrets API and will cause deployment errors.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Project URL and anon key — used by the Supabase JS client (@supabase/supabase-js)
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-public-key>"

# Service-role key — used ONLY in server-side code (Route Handlers, Server Actions)
# NEVER expose this to the browser.
# Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-key>"

# Pooled connection (Supavisor) — used at runtime by Prisma Client
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Supabase Dashboard → Settings → Database → Connection string → Transaction mode
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection — used ONLY by Prisma CLI (migrate, db push, studio)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Supabase Dashboard → Settings → Database → Connection string → Session mode
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"
JWT_REFRESH_SECRET="change-this-to-another-long-random-secret-min-32-chars"

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Monnify Payment Gateway
# -----------------------------------------------------------------------------
MONNIFY_API_KEY="your-monnify-api-key"
MONNIFY_SECRET_KEY="your-monnify-secret-key"
MONNIFY_CONTRACT_CODE="your-monnify-contract-code"
MONNIFY_BASE_URL="https://sandbox.monnify.com"
MONNIFY_WEBHOOK_SECRET="your-monnify-webhook-hash-secret"

# -----------------------------------------------------------------------------
# Email (optional — for future use)
# -----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL="noreply@peeplx.com"
